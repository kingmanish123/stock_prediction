# ─── LLM Configuration ───────────────────────────────
# Get Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Get Claude key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bulk NLP (sentiment, classification) — cheap + fast
LLM_BULK_PROVIDER=gemini
LLM_BULK_MODEL=gemini-2.5-flash

# Deep reasoning (top predictions) — higher quality
LLM_REASONING_PROVIDER=anthropic
LLM_REASONING_MODEL=claude-sonnet-4-6

# ─── Paths (relative to project root) ────────────────
DATA_DIR=./data
REPORTS_DIR=./reports
PREDICTIONS_DIR=./predictions
LOGS_DIR=./logs
MODELS_DIR=./models

# ─── External APIs ───────────────────────────────────
# Get Finnhub key: https://finnhub.io/register
FINNHUB_API_KEY=

# Get FRED key: https://fredaccount.stlouisfed.org/apikey
FRED_API_KEY=

# ─── Upstox broker API (real-time market data) ────────────────────────
# Create a developer app: https://upstox.com/developer/apps
# Redirect URI — put the same value in .env and on the Upstox app page
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8080/callback
# Leave blank — populated by `python scripts/upstox_login.py`
UPSTOX_ACCESS_TOKEN=

# ─── Database (MySQL via XAMPP, or any MySQL) ────────
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stock_prediction
DB_USER=root
DB_PASSWORD=
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/stock_prediction

# Legacy SQLite fallback (not used by default)
DB_PATH=./data/system.sqlite

# ─── Logging ─────────────────────────────────────────
LOG_LEVEL=INFO

# ─── News sources toggle (all free by default) ───────
ENABLE_NSE_ANNOUNCEMENTS=true
ENABLE_BSE_ANNOUNCEMENTS=true
ENABLE_MONEYCONTROL_RSS=true
ENABLE_ET_RSS=true
ENABLE_LIVEMINT_RSS=true
ENABLE_BUSINESS_STANDARD_RSS=true
ENABLE_YAHOO_FINANCE_NEWS=true

# V2 paid news (leave false for V1)
ENABLE_MARKETAUX=false
MARKETAUX_API_KEY=

# Reddit (leave false for V1)
ENABLE_REDDIT=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ─── Market data ─────────────────────────────────────
UNIVERSE=NIFTY100

# ─── Run configuration ───────────────────────────────
PRE_MARKET_RUN_TIME=08:00
POST_MARKET_RUN_TIME=16:00
TIMEZONE=Asia/Kolkata

# ─── Cost control ────────────────────────────────────
DAILY_LLM_BUDGET_INR=20
MAX_DEEP_REASONING_CALLS=15

# ─── WhatsApp automation (Baileys bot) ──────────────
# Your phone number with country code, no plus sign (e.g. 919876543210)
WHATSAPP_NUMBER=
# Local Baileys HTTP daemon (change if using different port)
WHATSAPP_BOT_URL=http://127.0.0.1:3001
